{
  "name": "15igl7",
  "description": "Lenovo IdeaPad 1 15IGL7 (Intel Gemini Lake, UHD 600/605, 1366x768). Not an Apple Mac; experimental only.",
  "note": "OpenCore config for Lenovo IdeaPad 1 15IGL7 (Gemini Lake, UHD 600/605). Replace serial/MLB/UUID before use. Kernel kexts intentionally empty: Gemini Lake lacks AVX2 and macOS 26 x86_64 may panic early. Booting the picker is not a macOS boot.",
  "drivers": [
    { "Path": "OpenRuntime.efi", "Comment": "Required by OpenCore" },
    { "Path": "OpenHfsPlus.efi", "Comment": "HFS+ reader (redistributable, from the OpenCore release)" }
  ],
  "tools": [
    { "Path": "OpenShell.efi", "Comment": "UEFI Shell (boot entry only, never a driver)" }
  ],
  "set": {
    "ACPI.Add": [],
    "ACPI.Delete": [],
    "ACPI.Patch": [],

    "Booter.Quirks.AvoidRuntimeDefrag": true,
    "Booter.Quirks.EnableSafeModeSlide": true,
    "Booter.Quirks.EnableWriteUnprotector": true,
    "Booter.Quirks.ProvideCustomSlide": true,
    "Booter.Quirks.SetupVirtualMap": true,
    "Booter.Quirks.SyncRuntimePermissions": true,
    "Booter.Quirks.RebuildAppleMemoryMap": false,
    "Booter.Quirks.DevirtualiseMmio": false,

    "DeviceProperties.Add": {
      "PciRoot(0x0)/Pci(0x2,0x0)": {
        "AAPL,ig-platform-id": { "$data": "BwCbPg==" },
        "device-id": { "$data": "mQAAAA==" }
      }
    },
    "DeviceProperties.Delete": {},

    "Kernel.Add": [],
    "Kernel.Block": [],
    "Kernel.Force": [],
    "Kernel.Patch": [],
    "Kernel.Emulate.Cpuid1Data": { "$data": "" },
    "Kernel.Emulate.Cpuid1Mask": { "$data": "" },
    "Kernel.Quirks.DisableLinkeditJettison": true,
    "Kernel.Quirks.PanicNoKextDump": true,
    "Kernel.Quirks.PowerTimeoutKernelPanic": true,
    "Kernel.Quirks.ProvideCurrentCpuInfo": true,
    "Kernel.Quirks.XhciPortLimit": true,
    "Kernel.Quirks.SetApfsTrimTimeout": -1,
    "Kernel.Scheme.KernelArch": "x86_64",

    "Misc.BlessOverride": [],
    "Misc.Boot.ShowPicker": true,
    "Misc.Boot.PickerMode": "Builtin",
    "Misc.Boot.PickerVariant": "Auto",
    "Misc.Boot.Timeout": 5,
    "Misc.Boot.HideAuxiliary": false,
    "Misc.Boot.PollAppleHotKeys": true,
    "Misc.Boot.PickerAttributes": 0,
    "Misc.Boot.HibernateMode": "None",
    "Misc.Boot.LauncherOption": "Disabled",
    "Misc.Debug.DisableWatchDog": true,
    "Misc.Entries": [
      {
        "Arguments": "",
        "Auxiliary": false,
        "Comment": "NextCore picker",
        "Enabled": true,
        "Flavour": "Auto",
        "Name": "NextCore Picker",
        "Path": "\\EFI\\NEXTCORE\\BOOTX64.EFI",
        "TextMode": false
      },
      {
        "Arguments": "",
        "Auxiliary": false,
        "Comment": "UEFI Shell helper",
        "Enabled": true,
        "Flavour": "OpenShell:UEFIShell:Shell",
        "Name": "UEFI Shell",
        "Path": "\\EFI\\OC\\Tools\\OpenShell.efi",
        "TextMode": false
      }
    ],
    "Misc.Security.ScanPolicy": 0,
    "Misc.Security.SecureBootModel": "Disabled",
    "Misc.Security.Vault": "Optional",
    "Misc.Security.AllowSetDefault": true,
    "Misc.Security.DmgLoading": "Signed",
    "Misc.Tools": [],

    "NVRAM.Add.7C436110-AB2A-4BBB-A880-FE41995C9F82.boot-args": "-v keepsyms=1 debug=0x100",
    "NVRAM.Add.7C436110-AB2A-4BBB-A880-FE41995C9F82.prev-lang:kbd": { "$data": "ZW4tVVM6MA==" },
    "NVRAM.Add.7C436110-AB2A-4BBB-A880-FE41995C9F82.csr-active-config": { "$data": "AAAAAA==" },
    "NVRAM.Add.7C436110-AB2A-4BBB-A880-FE41995C9F82.run-efi-updater": "No",

    "PlatformInfo.Generic.SystemProductName": "MacBookAir8,1",
    "PlatformInfo.Generic.SystemSerialNumber": "REPLACE_WITH_VALID_SERIAL",
    "PlatformInfo.Generic.MLB": "REPLACE_WITH_VALID_MLB",
    "PlatformInfo.Generic.SystemUUID": "00000000-0000-0000-0000-000000000000",
    "PlatformInfo.Generic.ROM": { "$data": "ESIzRFVm" },

    "UEFI.Output.ProvideConsoleGop": false,
    "UEFI.Output.Resolution": "1366x768",
    "UEFI.Output.TextRenderer": "BuiltinText",
    "UEFI.Output.UIScale": 0,
    "UEFI.Output.GopPassThrough": "Disabled",
    "UEFI.Quirks.ReleaseUsbOwnership": true,
    "UEFI.Quirks.RequestBootVarRouting": true,
    "UEFI.Quirks.EnableVectorAcceleration": true
  }
}
